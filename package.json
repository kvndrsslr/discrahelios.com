		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/enhanced-img": "0.10.3",
		"@sveltejs/kit": "2.53.0",
		"@sveltejs/vite-plugin-svelte": "6.2.4",
		"eslint": "10.0.1",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.15.0",
		"gh-pages": "6.3.0",
		"globals": "17.3.0",
		"mdsvex": "0.12.6",
		"npm-check-updates": "19.4.1",
		"prettier": "3.8.1",
